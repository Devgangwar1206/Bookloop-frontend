# Google Maps API Key for location, maps, and distance
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Backend Spring Boot REST API Base URL
# For local development: http://localhost:8000/api/v1
# For production deployment: https://your-backend-domain.com/api/v1
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Chat WebSocket URL (optional override)
# Defaults automatically to NEXT_PUBLIC_API_URL domain + /ws-chat
# For production: https://your-backend-domain.com/ws-chat
NEXT_PUBLIC_WS_URL="http://localhost:8000/ws-chat"

# AI Studio / Gemini configuration (if using AI Assistant)
GEMINI_API_KEY=""
APP_URL=""
